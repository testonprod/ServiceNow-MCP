# ServiceNow instance subdomain (e.g. "dev12345" for dev12345.service-now.com)
SN_INSTANCE=your-instance-name

# OAuth2 Client credentials (create in ServiceNow > System OAuth > Application Registry)
SN_CLIENT_ID=your-client-id
SN_CLIENT_SECRET="your-client-secret"

# ServiceNow user credentials (for server-side OAuth token acquisition)
SN_USERNAME=your-username
SN_PASSWORD="your-password"
