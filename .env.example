# ServiceNow instance subdomain (e.g. "dev12345" for dev12345.service-now.com)
SN_INSTANCE=your-instance-name

# OAuth2 Client ID (create in ServiceNow > System OAuth > Application Registry)
# The agent obtains its own OAuth token and passes it as a Bearer token.
# The server only needs the Client ID to expose via /auth/config for agent discovery.
SN_CLIENT_ID=your-client-id
